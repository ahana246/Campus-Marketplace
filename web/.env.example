DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=campus_marketplace

# Two MySQL accounts: one for students, one for admins
DB_STUDENT_USER=mp_student_app
DB_STUDENT_PASSWORD=student_app_pw
DB_ADMIN_USER=mp_admin_app
DB_ADMIN_PASSWORD=admin_app_pw

# Redis: key-value store + vector database
REDIS_URL=redis://127.0.0.1:6379

# Secret used to sign the login token
JWT_SECRET=change-me-to-a-long-random-string
